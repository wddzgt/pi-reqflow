{
  "name": "pi-reqflow",
  "description": "Controlled requirement delivery for existing systems, powered by Pi.",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wddzgt/pi-reqflow.git"
  },
  "homepage": "https://github.com/wddzgt/pi-reqflow#readme",
  "bugs": {
    "url": "https://github.com/wddzgt/pi-reqflow/issues"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "ai",
    "requirements",
    "workflow",
    "human-in-the-loop",
    "workbench"
  ],
  "exports": "./dist/server.js",
  "files": [
    "dist/",
    "src/files.js",
    "src/model-credentials.js",
    "web/minimal/",
    "examples/delivery.json"
  ],
  "type": "module",
  "bin": {
    "pi-reqflow": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "setup": "npm run build && node dist/cli.js init",
    "start": "npm run build && node dist/cli.js web",
    "check": "tsc --noEmit && node --check web/minimal/app.js && node --check web/minimal/records.js && node --check web/minimal/center.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "ajv": "^8.17.1",
    "diff": "9.0.0",
    "shell-quote": "1.8.3"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
