# Optional settings. Quick start does not require this file. Do not put API keys here.
# Omit REQFLOW_PROJECT_DIR to use the included demo, or select an existing directory.
REQFLOW_PROJECT_DIR=/absolute/path/to/target-project
# Only needed with compose.project.yaml for advanced CLI-managed initialization.
# REQFLOW_CONFIG_FILE=/absolute/path/to/config.docker.json
REQFLOW_PORT=4173
REQFLOW_PUBLIC_ORIGIN=http://localhost:4173
REQFLOW_UID=1000
REQFLOW_GID=1000
# Optional approved registry mirror or pinned digest for the Node base image.
# REQFLOW_NODE_IMAGE=node:22.22.0-bookworm-slim
# Optional published image; use `up -d --no-build` after pulling it.
# REQFLOW_IMAGE=ghcr.io/your-org/pi-reqflow:0.1.0
